# ─────────────────────────────────────────────────────────────────────────────
# Hotel Management System — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# JWT — Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# CORS — set to your frontend URL in production (e.g. https://yourapp.com)
CLIENT_ORIGIN=http://localhost:5173

# ─── Seed script credentials (scripts/seed.js ONLY) ──────────────────────────
# Use strong, unique passwords. Change immediately after first login in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
